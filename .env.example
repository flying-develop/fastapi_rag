# App
APP_NAME=ai-app-python
LOG_LEVEL=DEBUG

# Database (PostgreSQL). Host "postgres" matches the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://projects:projects@postgres:5432/ai_app
# Used by the postgres container itself (docker-compose) to create the DB/user
# — keep these in sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=projects
POSTGRES_PASSWORD=projects
POSTGRES_DB=ai_app

# Redis. Host "redis" matches the docker-compose service name.
REDIS_URL=redis://redis:6379/0

# Qdrant. Host "qdrant" matches the docker-compose service name.
QDRANT_URL=http://qdrant:6333

# LLM provider
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# S3-compatible storage (MinIO). Host "minio" matches the docker-compose service name.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=files
S3_REGION=us-east-1
# Used by the minio container itself (docker-compose) to set up its root
# credentials — keep these in sync with S3_ACCESS_KEY/S3_SECRET_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
